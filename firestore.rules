rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── ADMIN CHECK ─────────────────────────────────────────────────────
    // Anyone signed in (Email/Password or Google) with an email on this
    // list can manage CMS content. Add more admins here as needed — this
    // list is the only gate, so keep it accurate.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'wawerujoe@gmail.com'
        ];
    }

    // ── PUBLIC LEAD FORMS (demo requests, contact messages, newsletter) ──
    match /website_leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'org', 'email', 'phone', 'product', 'notes',
          'subject', 'message', 'subscribe', 'kind', 'source', 'createdAt'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.kind in ['demo_request', 'contact_message', 'newsletter_signup'] &&
        request.resource.data.source == 'system-partners-website' &&
        request.resource.data.createdAt == request.time &&
        (
          (
            request.resource.data.kind == 'demo_request' &&
            request.resource.data.keys().hasOnly(['name', 'org', 'email', 'phone', 'product', 'notes', 'kind', 'source', 'createdAt']) &&
            request.resource.data.name is string &&
            request.resource.data.name.size() >= 2 &&
            request.resource.data.name.size() <= 120 &&
            request.resource.data.org is string &&
            request.resource.data.org.size() >= 2 &&
            request.resource.data.org.size() <= 160 &&
            request.resource.data.phone is string &&
            request.resource.data.phone.size() <= 40 &&
            request.resource.data.product in ['Funsoft I-HMIS', 'ERP', 'Funsoft Healthcare AI'] &&
            request.resource.data.notes is string &&
            request.resource.data.notes.size() <= 2000
          ) ||
          (
            request.resource.data.kind == 'contact_message' &&
            request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'subscribe', 'kind', 'source', 'createdAt']) &&
            request.resource.data.name is string &&
            request.resource.data.name.size() >= 2 &&
            request.resource.data.name.size() <= 120 &&
            request.resource.data.subject is string &&
            request.resource.data.subject.size() <= 160 &&
            request.resource.data.message is string &&
            request.resource.data.message.size() >= 10 &&
            request.resource.data.message.size() <= 4000 &&
            request.resource.data.subscribe is bool
          ) ||
          (
            request.resource.data.kind == 'newsletter_signup' &&
            request.resource.data.keys().hasOnly(['email', 'kind', 'source', 'createdAt'])
          )
        );

      // Leads are a write-only inbox from the public site's perspective —
      // only an admin can read/manage them (e.g. from a future admin inbox view).
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── CMS-MANAGED SITE CONTENT ─────────────────────────────────────────
    // Public site reads these to render testimonials, pricing, stats, etc.
    // Only allow-listed admins (via isAdmin()) can create/edit/delete them.
    match /site_content/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
