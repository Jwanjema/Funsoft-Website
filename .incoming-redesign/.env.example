VITE_FIREBASE_PROJECT_ID=funsoft---cms
VITE_FIREBASE_STORAGE_BUCKET=funsoft---cms.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=879383876676
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Lead notification emails (demo request / contact form) are sent by the
# /api/send-lead-email Vercel serverless function via SMTP — see
# api/send-lead-email.js and api/_smtp.js. Configure the mailbox credentials
# as Vercel project environment variables (not here — these are server-side
# only, never exposed to the browser, so do NOT prefix them with VITE_):
#   SMTP_HOST=da33.host-ww.net
# NOTE: mail.funsofthealthcare.com resolves to the same server, but its TLS
# certificate only covers "da33.host-ww.net" — using the alias here causes
# a "Hostname/IP does not match certificate's altnames" TLS error.
#   SMTP_PORT=587
#   SMTP_USER=info@funsofthealthcare.com
#   SMTP_PASS=
#   SMTP_FROM=info@funsofthealthcare.com
#   CONTACT_TO_EMAIL=info@funsofthealthcare.com
